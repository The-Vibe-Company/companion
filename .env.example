# Companion local environment.

# --- Public origins and product gates --------------------------------------
COMPANION_API_URL=http://127.0.0.1:3001
COMPANION_WEB_URL=http://127.0.0.1:3000
# Health `release_id` is derived automatically from the deployed commit: Railway injects
# RAILWAY_GIT_COMMIT_SHA (preferred), then SOURCE_COMMIT, then GITHUB_SHA in CI. Local/dev falls
# back to "local". Do not set COMPANION_RELEASE_ID; leftovers are ignored.
NEXT_PUBLIC_COMPANION_API_URL=http://127.0.0.1:3001
# Optional PostHog web analytics. Get these from the PostHog project settings.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Authentication and skill secrets ---------------------------------------
# In production use the API's public origin; Google OAuth uses /auth/callback/google.
BETTER_AUTH_URL=http://127.0.0.1:3001
BETTER_AUTH_COOKIE_PREFIX=better-auth
BETTER_AUTH_SECRET=replace-with-a-32-byte-random-secret
# API-only encryption key for Skills Hub secrets. Generate with:
# node -e "process.stdout.write(require('crypto').randomBytes(32).toString('base64'))"
# Local launchers generate and persist a gitignored workspace key when this is empty.
COMPANION_SECRETS_MASTER_KEY=

# --- GitHub skill mirrors (optional GitHub App) -----------------------------
# Register one GitHub App with user-to-server OAuth enabled. Callback URL:
# ${COMPANION_WEB_URL}/v1/integrations/github/callback (the web origin proxies /v1 to the API)
# Permissions: Metadata read, Contents read/write, Administration read/write.
# In split production deployments, expose slug/client credentials only to the API and App ID/private
# key only to the worker. Local launchers read this combined file once, then dev-process.sh applies
# the same per-process allowlists before starting API, worker, or web.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM with literal \n characters or the PEM bytes encoded as base64.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_NAME=
# API-side acknowledgement that a separately configured worker can converge mirrors.
# Leave false to disable Workspace Settings > GitHub cleanly.
COMPANION_GITHUB_SYNC_ENABLED=false
# SaaS only: renders the official Companion App wording. Self-hosted stays false.
COMPANION_GITHUB_APP_MANAGED=false

# --- Skill databases --------------------------------------------------------
COMPANION_SKILL_DATABASES_ENABLED=false
# Bound hot-realm lock retries and queued SQLite WASM work.
COMPANION_SKILL_DB_LOCK_WAIT_MS=2500
COMPANION_SKILL_DB_STORAGE_TIMEOUT_MS=5000
COMPANION_SKILL_DB_DELETE_TIMEOUT_MS=5000
COMPANION_SKILL_DB_MAX_QUEUED_TASKS=8
COMPANION_SKILL_DB_MAX_QUEUED_BYTES=67108864
COMPANION_SKILL_DB_MAX_STARTUP_FAILURES=3
COMPANION_SKILL_DB_STARTUP_TIMEOUT_MS=10000
# --- Google OAuth (Better Auth social provider) -----------------------------
# Optional: the "Continue with Google" button always renders, but Google sign-in is only wired when
# both are set. Authorized redirect URI to register in Google Cloud: ${BETTER_AUTH_URL}/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Postgres ---------------------------------------------------------------
# API and worker use distinct LOGIN NOSUPERUSER/NOBYPASSRLS/NOINHERIT roles that do not
# own tables. Migrations use the separate owner URL. The retired runtime role below remains
# only for replaying historical migrations; no application process receives its URL.
DATABASE_URL=postgres://companion_api:companion-api@127.0.0.1:5432/companion
DATABASE_WORKER_URL=postgres://companion_worker:companion-worker@127.0.0.1:5432/companion
DATABASE_COMPANION_RUNTIME_URL=postgres://companion_runtime_v2:companion-runtime-v2@127.0.0.1:5432/companion
DATABASE_MIGRATION_URL=postgres://companion:companion@127.0.0.1:5432/companion
# Production one-shot release job: checkpoint through 0092, apply the exact separated grants, then
# admit the guarded 0093 cutover on that same PostgreSQL connection. Never provide these variables
# or DATABASE_MIGRATION_URL to a long-lived API, worker, or web process.
DATABASE_API_ROLE=companion_api
DATABASE_WORKER_ROLE=companion_worker
# Historical migration/grant compatibility only; this is not a running service.
DATABASE_COMPANION_RUNTIME_ROLE=companion_runtime_v2
# Upgrade only: after ALTER ROLE ... NOLOGIN, draining every old session, and removing its role
# memberships, name the former union credential so the hook can revoke all remaining ACLs.
# Fresh installs omit this only when no legacy union ACL footprint exists. DATABASE_RUNTIME_ROLE is
# permanently rejected as an active credential.
# DATABASE_RETIRED_RUNTIME_ROLE=companion_runtime_legacy
# Release job only: optional readable override for packages/db/runtime-role-grants.sql.
# Normal source and packaged images discover the file without this setting.
# COMPANION_RUNTIME_GRANTS_FILE=
# Deployments upgrading from a release that still ran Projects and runs must settle their object
# storage and sandbox obligations once, with `node dist/cutover.js`, before migration 0063 can apply.
# It needs the migration URL above and the S3 credentials below. See deploy/railway/README.md.
COMPOSE_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Sentry monitoring ------------------------------------------------------
# Optional Sentry DSNs for error tracking and performance monitoring.
# Frontend DSN is inlined into the Next.js client bundle at image build time
# (Railway Docker ARG), same as NEXT_PUBLIC_POSTHOG_*. Changing it requires a
# web rebuild, not only a runtime env update.
# Frontend:
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
# Backend services (API, Worker, Runtime): set a distinct DSN per service so
# events stay separated. Runtime events are expurgated before send.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Optional immutable deploy identifier shared by backend services for release correlation:
SENTRY_RELEASE=
# Optional auth token for uploading source maps during the web build only:
# SENTRY_AUTH_TOKEN=

# --- S3-compatible storage (MinIO locally) ---------------------------------
# API owns normal storage writes. Runtime also needs GetObject for selected Skill archives; use a
# separate read-only credential in production even though the variable names are the same per service.
S3_ENDPOINT=http://127.0.0.1:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=companion
S3_SECRET_ACCESS_KEY=companion-secret
S3_BUCKET_SKILL_ARCHIVES=skill-archives
S3_FORCE_PATH_STYLE=true

# --- Email ------------------------------------------------------------------
# Verification + password-reset codes and org invites are sent through this provider. Use "mailpit"
# (read codes in the Mailpit UI) or "log" (console) locally; set "resend" + RESEND_API_KEY in production.
EMAIL_PROVIDER=mailpit
EMAIL_FROM=Companion <noreply@companion.local>
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
RESEND_API_KEY=

# --- Billing (SaaS only; self-hosted defaults stay fully unlocked) ----------
COMPANION_BILLING_MODE=disabled
COMPANION_ENTITLEMENTS_MODE=off
COMPANION_ENTITLEMENT_PILOT_ORGS=
COMPANION_PRO_ORG_ALLOWLIST=
COMPANION_CHECKOUT_ENABLED=false
COMPANION_STRIPE_WEBHOOKS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
