{
  "name": "companion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Companion \u2014 self-hostable Skills Hub for organizations and coding agents.",
  "repository": {
    "type": "git",
    "url": "https://github.com/The-Vibe-Company/companion.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.16": "1.1.16",
      "brace-expansion@>=3.0.0 <5.0.9": "5.0.9",
      "fast-uri@>=3.0.0 <3.1.6": "3.1.6",
      "js-yaml@>=4.0.0 <4.3.0": "4.3.0",
      "postcss": "8.5.18",
      "nanoid@<3.3.18": "3.3.18",
      "sharp": "0.35.3",
      "vite": "6.4.3",
      "shell-quote": "1.10.0",
      "undici@>=7.0.0 <7.29.0": "7.29.0"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "compose:up": "docker compose up -d postgres minio mailpit minio-init",
    "compose:down": "docker compose down",
    "db:generate": "pnpm --filter @companion/db drizzle-kit generate",
    "db:migrate": "pnpm --filter @companion/api exec tsx src/migrate.ts",
    "db:seed": "pnpm --filter @companion/db seed",
    "dev": "bash scripts/dev-stack.sh",
    "dev:conductor": "bash scripts/dev-conductor.sh",
    "dev:app": "pnpm exec concurrently -k -n api,worker,runtime,web \"bash scripts/dev-process.sh api env COMPANION_API_HOST=${COMPANION_API_HOST:-127.0.0.1} pnpm --filter @companion/api dev\" \"bash scripts/dev-worker.sh pnpm --filter @companion/worker dev\" \"bash scripts/dev-runtime.sh pnpm --filter @companion/runtime dev\" \"bash scripts/dev-process.sh web pnpm --filter @companion/web dev --hostname ${COMPANION_WEB_HOST:-127.0.0.1} --port ${COMPANION_WEB_PORT:-3000}\"",
    "dev:check": "bash scripts/dev-stack-check.sh",
    "ios:dev": "bash apps/ios/scripts/dev-conductor.sh",
    "ios:live": "bash scripts/dev-ios-live.sh",
    "ios:live:archive": "bash scripts/dev-ios-live.sh archive",
    "ios:test": "xcodebuildmcp swift-package test --package-path apps/ios/CompanionKit",
    "lint": "pnpm lint:anti-slop && turbo run lint",
    "lint:anti-slop": "node scripts/lint-anti-slop.mjs",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:anti-slop && TZ=UTC turbo run test",
    "test:anti-slop": "node --test scripts/lint-anti-slop.test.mjs scripts/lint-anti-slop.integration.test.mjs scripts/macos-devx.test.mjs scripts/macos-release.test.mjs",
    "test:coverage": "turbo run coverage",
    "test:integration": "pnpm --filter @companion/api test:integration",
    "test:e2e": "node scripts/ci-playwright-policy.mjs && playwright test",
    "ci:quality": "turbo run lint typecheck test --continue=dependencies-successful",
    "verify:change": "node scripts/verify-change.mjs",
    "verify:runtime-v3-contraction": "node --test scripts/runtime-v3-contraction-guard.test.mjs scripts/runtime-v3-cutover-rehearsal.test.mjs && node scripts/runtime-v3-contraction-guard.mjs",
    "rehearse:runtime-v3-cutover": "node scripts/runtime-v3-cutover-rehearsal.mjs",
    "browser:smoke": "bash scripts/agent-browser-smoke.sh",
    "box:lab:doctor": "bash scripts/box-lab.sh doctor",
    "box:lab:smoke": "bash scripts/box-lab.sh smoke",
    "box:lab:shell": "bash scripts/box-lab.sh shell",
    "box:lab:reset": "bash scripts/box-lab.sh reset",
    "e2e:box-runtime-change": "pnpm --filter @companion/api exec tsx \"$PWD/scripts/box-runtime-change-e2e.ts\"",
    "pi-bundle:check": "pnpm --filter @companion/api exec tsx \"$PWD/scripts/check-pi-bundle-artifact.ts\"",
    "smoke:api": "bash scripts/ci-api-smoke.sh",
    "smoke:rsc": "bash scripts/ci-rsc-smoke.sh",
    "cli": "pnpm --filter @companion/cli exec companion",
    "design:lint": "npx --yes @google/design.md@0.2.0 lint DESIGN.md --format json"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@playwright/test": "1.61.1",
    "@vitest/coverage-v8": "3.2.7",
    "concurrently": "^9.2.1",
    "oxlint": "1.79.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "zod": "^4.0.0"
  }
}
