# Build the Companion binary, then assemble a tiny Tailscale-joined runtime that
# serves the status dashboard. The fleet topology (fleet.json) is generated by
# `companion apply` and copied in at build time, so each rollout ships the
# current set of services + URLs to poll. No secrets are baked in — read tokens
# arrive as Fly secrets.
#
# Build context: like Dockerfile and Dockerfile.open-webui, this expects the
# repository root as the Fly build context (it COPYs go.mod, the Go source,
# bin/, and .companion/generated/fleet.json). Run `companion apply` from a
# workspace that sits at the repo root (or that vendors these files); the
# anonymized examples/ workspaces are for validate/plan, not live apply.
FROM golang:1.25-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/companion ./cmd/companion

FROM docker.io/tailscale/tailscale:stable AS tailscale

FROM debian:bookworm-slim
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates iptables && \
    rm -rf /var/lib/apt/lists/*

COPY --from=tailscale /usr/local/bin/tailscale /usr/local/bin/tailscale
COPY --from=tailscale /usr/local/bin/tailscaled /usr/local/bin/tailscaled
COPY --from=build /out/companion /usr/local/bin/companion
COPY --chmod=0755 bin/start-dashboard-on-fly /usr/local/bin/companion-dashboard-start
COPY .companion/generated/fleet.json /workspace/fleet.json

ENV PORT=9300
ENV TAILSCALE_STATE_DIR=/tmp/tailscale
ENV TS_ACCEPT_DNS=true
ENV DASHBOARD_TAILSCALE_SERVE=true
ENV COMPANION_FLEET_MANIFEST=/workspace/fleet.json

ENTRYPOINT ["/usr/local/bin/companion-dashboard-start"]
CMD ["companion", "dashboard", "--manifest", "/workspace/fleet.json"]
